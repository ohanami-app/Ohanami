<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Ohanami.RemoveData.Tests</AssemblyName>
    <RootNamespace>Ohanami.RemoveData.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- App と同じ形(App への参照がこの形を要求する) -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Ohanami.App\Ohanami.App.csproj" />
    <ProjectReference Include="..\..\src\Ohanami.Core\Ohanami.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

</Project>
