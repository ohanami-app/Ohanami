<Project Sdk="Microsoft.NET.Sdk">

  <!-- tools/Ohanami.Bench の純粋な計算(集計・TSV・比較)のテスト。GPU も私物の画像も使わない。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Ohanami.Bench.Tests</AssemblyName>
    <RootNamespace>Ohanami.Bench.Tests</RootNamespace>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\tools\Ohanami.Bench\Ohanami.Bench.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

</Project>
