<Project Sdk="Microsoft.NET.Sdk">

  <!-- tools/Ohanami.KanaYardstick の、画像の仕様の作り方・描画・採点の数え方のテスト。GPU も llama-server も使わない。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Ohanami.KanaYardstick.Tests</AssemblyName>
    <RootNamespace>Ohanami.KanaYardstick.Tests</RootNamespace>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\tools\Ohanami.KanaYardstick\Ohanami.KanaYardstick.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

</Project>
