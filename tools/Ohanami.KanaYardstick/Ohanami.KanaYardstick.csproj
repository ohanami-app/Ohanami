<Project Sdk="Microsoft.NET.Sdk">

  <!--
    濁点・半濁点の読み取りの尺。合成した画像(正解は作った文)を VLM に流して、濁点・半濁点だけの誤りを数える(ADR 0019 の測定の再現と、次の VLM の候補の物差し)。
    私物の画像に依存しない。画像は WPF(FormattedText)で描く: 測った数字を取った画像と同じ画素にするため、Skia には替えない。
    Core は プロンプトとスキーマの文字列を製品と同じにするためだけに参照する(llama-server の起動と要求の組み立ては、候補のモデルに合わせて変えられるよう、この道具の中に持つ)。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Ohanami.KanaYardstick</AssemblyName>
    <RootNamespace>Ohanami.KanaYardstick</RootNamespace>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Ohanami.Core\Ohanami.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ohanami.KanaYardstick.Tests" />
  </ItemGroup>

</Project>
